{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["content", "page", "size", "totalElements", "totalPages"],
  "properties": {
    "content":       { "type": "array", "items": { "$ref": "#/definitions/Studio" } },
    "page":          { "type": "integer" },
    "size":          { "type": "integer" },
    "totalElements": { "type": "integer" },
    "totalPages":    { "type": "integer" }
  },
  "definitions": {
    "Studio": {
      "type": "object",
      "required": ["sid", "name"],
      "additionalProperties": false,
      "properties": {
        "sid":  { "type": "integer" },
        "name": { "type": "string" }
      }
    }
  }
}