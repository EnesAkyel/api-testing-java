{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["content", "page", "size", "totalElements", "totalPages"],
  "properties": {
    "content":       { "type": "array", "items": { "$ref": "#/definitions/Movie" } },
    "page":          { "type": "integer" },
    "size":          { "type": "integer" },
    "totalElements": { "type": "integer" },
    "totalPages":    { "type": "integer" }
  },
  "definitions": {
    "Movie": {
      "type": "object",
      "required": ["mid", "name", "genre", "price", "rating", "studio"],
      "additionalProperties": false,
      "properties": {
        "mid":    { "type": "integer" },
        "name":   { "type": "string" },
        "genre":  { "type": "string" },
        "price":  { "type": "number" },
        "rating": { "type": "string" },
        "studio": { "type": "integer" }
      }
    }
  }
}