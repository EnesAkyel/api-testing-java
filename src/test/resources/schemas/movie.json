{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mid", "name", "genre", "price", "rating", "studio"],
  "additionalProperties": false,
  "properties": {
    "mid":    { "type": "integer" },
    "name":   { "type": "string" },
    "genre":  { "type": "string" },
    "price":  { "type": "number" },
    "rating": { "type": "string" },
    "studio": { "type": "integer" }
  }
}